{
  "name": "agent_game",
  "version": "0.1.0",
  "description": "Local LLM-driven 2D harness debug runtime",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test src/**/*.test.ts",
    "profile:lmstudio": "tsx src/server/profile.ts",
    "harness:headless": "tsx src/server/headless.ts",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "start": "tsx src/server/main.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "effect": "^3.21.0",
    "express": "^5.2.1",
    "openai": "^6.32.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.1"
  }
}
